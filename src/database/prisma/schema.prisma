// ─────────────────────────────────────────────
//  STARBOARD
// ─────────────────────────────────────────────

model StarboardConfig {
  id              String   @id @default(cuid())
  guildId         String   @unique
  channelId       String
  emoji           String   @default("⭐")
  threshold       Int      @default(3)
  selfStar        Boolean  @default(false)
  ignoreBots      Boolean  @default(true)
  ignoreNsfw      Boolean  @default(true)
  enabled         Boolean  @default(true)
  ignoredChannels String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  entries         StarboardEntry[]

  @@map("starboard_configs")
}

model HoneypotConfig {
  id              String   @id @default(cuid())
  guildId         String   @unique
  enabled         Boolean  @default(true)

  // Trap channel
  channelEnabled  Boolean  @default(false)
  channelId       String?
  channelAction   String   @default("kick")   // kick | ban | timeout | log

  // Anti-raid (sliding window)
  raidEnabled     Boolean  @default(true)
  raidThreshold   Int      @default(10)        // joins within the period
  raidWindow      Int      @default(10)        // seconds
  raidAction      String   @default("log")    // lockdown | kick | ban | log

  // New account filter
  newAccountEnabled Boolean @default(false)
  newAccountDays    Int     @default(7)        // minimum account age in days
  newAccountAction  String  @default("kick")

  // Log channel
  logChannelId    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("honeypot_configs")
}

model HoneypotLog {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  type      String   // channel_message | mass_join | new_account
  action    String   // kicked | banned | timed_out | logged
  details   String?
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([guildId, createdAt])
  @@map("honeypot_logs")
}

model StarboardEntry {
  id             String        @id @default(cuid())
  guildId        String
  configId       String?
  originalMsgId  String        @unique
  originalChId   String
  starboardMsgId String
  authorId       String
  starCount      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  guild          Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  config         StarboardConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)

  @@index([guildId])
  @@index([authorId])
  @@map("starboard_entries")
}

// ═══════════════════════════════════════════════════════════════
// TEAM ACCESS — per-guild RBAC
// ═══════════════════════════════════════════════════════════════

model GuildOperator {
  id          String    @id @default(cuid())
  guildId     String
  userId      String    // Discord User ID of the collaborator
  invitedBy   String    // Discord User ID of the inviter
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expiresAt   DateTime?             // null = no expiration
  revokedAt   DateTime?             // null = active
  revokedBy   String?               // who revoked

  // Per-section permissions — see OperatorPermissions in types/teamAccess.ts
  permissions Json

  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId])
  @@index([userId])
  @@index([guildId, userId, revokedAt])
  @@map("guild_operators")
}

model GuildOperatorLog {
  id          String   @id @default(cuid())
  guildId     String
  operatorId  String   // Discord userId of who performed the action
  username    String   // snapshot of the username at that time
  action      String   // "config_saved" | "invite_generated" | "operator_added" | "operator_revoked" | etc.
  section     String   // "moderation" | "economy" | "team" | etc.
  details     Json     // additional data (before/after, parameters, etc.)
  ipHash      String?  // SHA-256 hash of the IP (GDPR: never store the IP in plain text)
  createdAt   DateTime @default(now())

  @@index([guildId])
  @@index([guildId, createdAt])
  @@index([operatorId])
  @@map("guild_operator_logs")
}

// Channels locked with /lockdown: original @everyone overwrite to restore it
// exactly on unlock (also after a bot restart)
model ChannelLockdown {
  channelId     String   @id
  guildId       String
  type          String   // channel | server
  everyoneAllow String?  // original bitfield (null = there was no overwrite)
  everyoneDeny  String?
  moderatorId   String
  reason        String
  createdAt     DateTime @default(now())

  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@map("channel_lockdowns")
}

// Pinned messages re-posted at the bottom of the channel (/sticky)
model StickyMessage {
  channelId String   @id
  guildId   String
  content   String
  useEmbed  Boolean  @default(false)
  color     Int?
  messageId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@map("sticky_messages")
}

// Per-user invite statistics (/invites)
model InviteStats {
  id           String   @id @default(cuid())
  guildId      String
  userId       String
  totalInvites Int      @default(0)
  validInvites Int      @default(0)
  fakeInvites  Int      @default(0)
  leftInvites  Int      @default(0)
  bonusInvites Int      @default(0)
  invitedUsers String[] @default([])
  fakeInvitedUsers String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  guild        Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId])
  @@map("invite_stats")
}

// Invite rewards: per-server settings (/invites config)
model InviteRewardConfig {
  guildId           String   @id
  enabled           Boolean  @default(true)
  stackRoles        Boolean  @default(true)  // true: keeps previous roles; false: only the highest
  removeOnDrop      Boolean  @default(true)  // removes the role if valid invites drop below the threshold
  announceChannelId String?                  // optional announcement when a reward is reached
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  guild             Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("invite_reward_configs")
}

// Invite rewards: threshold (valid invites) → role
model InviteRewardTier {
  id              String   @id @default(cuid())
  guildId         String
  requiredInvites Int
  roleId          String
  createdAt       DateTime @default(now())

  guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, requiredInvites])
  @@unique([guildId, roleId])
  @@index([guildId])
  @@map("invite_reward_tiers")
}

// Reward roles granted by the bot (only these are removed later)
model InviteRewardGrant {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  roleId    String
  grantedAt DateTime @default(now())

  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId, roleId])
  @@index([guildId, userId])
  @@map("invite_reward_grants")
}

model GuildOperatorInvite {
  id          String    @id @default(cuid())
  guildId     String
  token       String    @unique @default(cuid())
  invitedBy   String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  usedBy      String?   // Discord User ID of who accepted
  targetUserId String?  // If set, only this Discord ID can accept the invite
  permissions Json      // permissions pre-assigned to the invite

  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([guildId])
  @@map("guild_operator_invites")
}
