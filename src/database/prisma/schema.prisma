// Korex Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Usar postgresql por defecto
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// MODELOS CORE
// ═══════════════════════════════════════════════════════════════

model Guild {
  id        String   @id // Discord Guild ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Configuración general
  prefix        String   @default("!")
  prefixEnabled Boolean  @default(true) // Comandos con prefijo/mención activados
  language      String   @default("es")
  timezone      String   @default("UTC")
  embedColor    String   @default("#00D9FF")
  
  // Módulos habilitados
  enabledAddons String[] @default([])

  // Identidad del bot por servidor
  botNickname   String?

  // Suspensión de cuenta (por el equipo de Korex admin)
  suspended     Boolean   @default(false)
  suspendedAt   DateTime?
  suspendReason String?

  // Registro de salida del bot del servidor
  leftAt        DateTime?
  
  // Configuración de módulos
  moderationConfig  ModerationConfig?
  moderationRaidState ModerationRaidState?
  welcomeConfig     WelcomeConfig?
  levelConfig       LevelConfig?
  economyConfig     EconomyConfig?
  loggingConfig     LoggingConfig?
  musicConfig       MusicConfig?
  
  // Relaciones
  users             GuildUser[]
  moderationCases   ModerationCase[]
  warnings          Warning[]
  customCommands    CustomCommand[]
  reactionRoles     ReactionRole[]
  giveaways         Giveaway[]
  suggestions       Suggestion[]
  addonLicenses     AddonLicense[]
  addonConfigs      AddonConfig[]
  shopItems         ShopItem[]
  premium           GuildPremium?
  starboardConfig      StarboardConfig?
  starboardEntries     StarboardEntry[]
  honeypotConfig       HoneypotConfig?
  honeypotLogs         HoneypotLog[]
  operators            GuildOperator[]
  operatorInvites      GuildOperatorInvite[]

  @@map("guilds")
  inviteStats     InviteStats[]
  stickyMessages  StickyMessage[]
  channelLockdowns ChannelLockdown[]
  inviteRewardConfig InviteRewardConfig?
  inviteRewardTiers  InviteRewardTier[]
  inviteRewardGrants InviteRewardGrant[]
}

model User {
  id        String   @id // Discord User ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Datos globales del usuario
  globalXp       Int      @default(0)
  globalLevel    Int      @default(0)
  globalBalance  Int      @default(0)
  premiumUntil   DateTime?
  badges         String[] @default([])
  
  // Configuración personal
  language       String   @default("es")
  dmNotifications Boolean @default(true)
  
  // Relaciones
  guilds         GuildUser[]
  
  @@map("users")
}

model GuildUser {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Niveles y XP
  xp           Int      @default(0)
  level        Int      @default(0)
  totalXp      Int      @default(0)
  messages     Int      @default(0)
  voiceMinutes Int      @default(0)
  lastXpGain   DateTime?

  // Economía
  balance      Int      @default(0)
  bank         Int      @default(0)
  dailyStreak  Int      @default(0)
  lastDaily    DateTime?
  lastWeekly   DateTime?
  lastWork     DateTime?

  // Moderación
  warnings     Warning[]
  notes        String[]  @default([])
  isMuted      Boolean   @default(false)
  muteExpires  DateTime?

  // AFK
  isAfk        Boolean   @default(false)
  afkMessage   String?
  afkSince     DateTime?

  // Relaciones
  guild        Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId])
  @@index([userId])
  @@map("guild_users")
}

// ═══════════════════════════════════════════════════════════════
// CONFIGURACIONES
// ═══════════════════════════════════════════════════════════════

model ModerationConfig {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  // Auto-moderación
  autoModEnabled     Boolean  @default(false)
  antiSpam           Boolean  @default(false)
  antiSpamThreshold  Int      @default(5)
  antiSpamInterval   Int      @default(5)
  antiRaid           Boolean  @default(false)
  antiRaidThreshold  Int      @default(10)        // entradas en la ventana
  // Anti-raid de Moderación (columnas aditivas): ventana, filtro de edad,
  // acción sobre quienes entran durante el raid, modo bloqueo y duración
  antiRaidWindow         Int    @default(60)      // segundos (10 = "usuarios por minuto")
  antiRaidAccountAgeDays Int    @default(0)       // 0 = cuenta cualquier cuenta; >0 solo cuentas más nuevas
  antiRaidAction         String @default("alert") // alert | timeout | kick | ban
  antiRaidLockdown       String @default("none")  // none | verification | channels | both
  antiRaidDuration       Int    @default(600)     // segundos hasta desactivar el modo raid
  antiNuke           Boolean  @default(false)
  antiGhostPing      Boolean  @default(false)
  
  // Filtros
  wordFilterEnabled  Boolean  @default(false)
  filteredWords      String[] @default([])
  linkFilterEnabled  Boolean  @default(false)
  allowedLinks       String[] @default([])
  capsFilterEnabled  Boolean  @default(false)
  capsThreshold      Int      @default(70)
  
  // Acciones automáticas
  warnThreshold      Int      @default(3)
  warnAction         String   @default("timeout") // timeout, kick, ban
  warnActionDuration Int      @default(3600)
  // Escalado por avisos de /setup (3 → silencio, 5 → expulsión, 7 → baneo), desactivado por defecto
  warnEscalationEnabled Boolean @default(false)
  warnEscalationSteps   Json    @default("[{\"warnings\":3,\"action\":\"timeout\",\"duration\":60},{\"warnings\":5,\"action\":\"kick\"},{\"warnings\":7,\"action\":\"ban\",\"duration\":1440}]")
  applyToModerators  Boolean  @default(false)
  
  // Canales ignorados
  ignoredChannels    String[] @default([])
  ignoredRoles       String[] @default([])

  // Anti-spam de adjuntos (imágenes, archivos)
  antiAttachmentSpam        Boolean @default(false)
  antiAttachmentThreshold   Int     @default(3)
  antiAttachmentInterval    Int     @default(10)
  maxAttachmentsPerMessage  Int     @default(0)
  blockAllAttachments       Boolean @default(false)

  @@map("moderation_configs")
}

// Estado del modo raid de Moderación (uno por servidor). Guarda la instantánea
// del estado previo (nivel de verificación y permisos de @everyone) para
// restaurarlo exactamente aunque el bot se reinicie durante el raid.
model ModerationRaidState {
  guildId            String    @id
  guild              Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  active             Boolean   @default(true)
  startedAt          DateTime  @default(now())
  endsAt             DateTime
  endedAt            DateTime?
  endedBy            String?   // id de usuario, "auto" o "dashboard:<id>"
  joinCount          Int       @default(0)
  actionCount        Int       @default(0)
  action             String    @default("alert")
  verificationBefore Int?      // null = no se cambió
  verificationSet    Int?
  channelSnapshot    Json      @default("[]") // [{ id, existed, bits: { SendMessages: true|false|null, ... } }]
  updatedAt          DateTime  @updatedAt

  @@index([active, endsAt])
  @@map("moderation_raid_states")
}

model WelcomeConfig {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  // Bienvenida
  welcomeEnabled   Boolean @default(false)
  welcomeChannelId String?
  welcomeMessage   String  @default("¡Bienvenido {user} a {server}!")
  welcomeEmbed     Json?
  welcomeImage         Boolean @default(false)
  welcomeImageUrl      String?
  welcomeImageTemplate String  @default("modern-dark")
  welcomeDM            Boolean @default(false)
  welcomeDMMessage String?

  // Despedida
  goodbyeEnabled   Boolean @default(false)
  goodbyeChannelId String?
  goodbyeMessage   String  @default("¡Hasta luego {user}!")
  goodbyeEmbed     Json?
  goodbyeImage     Boolean @default(false)
  goodbyeImageUrl  String?

  // Auto-rol
  autoRoleEnabled  Boolean  @default(false)
  autoRoles        String[] @default([])

  // Verificación
  verificationEnabled    Boolean @default(false)
  verificationRole       String?
  verificationType       String  @default("button") // button | reaction | captcha
  verificationChannel    String?
  verificationMessageId  String?
  verificationEmoji      String  @default("✅")
  verificationEmbedTitle String  @default("Server Verification")
  verificationEmbedDesc  String  @default("Click the button below to verify yourself and gain access to the server.")
  verificationEmbedColor String  @default("#5865F2")
  // Captcha (solo con verificationType = "captcha")
  verificationCaptchaMaxAttempts Int    @default(3)      // fallos permitidos por código (1-10)
  verificationCaptchaCooldown    Int    @default(10)     // minutos de bloqueo al agotar intentos (1-1440)
  verificationCaptchaFailAction  String @default("none") // none | kick
  // Tiempo límite para verificarse tras unirse (0 = desactivado), en minutos
  verificationTimeoutMinutes     Int    @default(0)

  @@map("welcome_configs")
}

model LevelConfig {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  enabled           Boolean  @default(true)
  xpPerMessage      Int      @default(15)
  xpPerVoiceMinute  Int      @default(5)
  xpCooldown        Int      @default(60)
  xpMultiplier      Float    @default(1.0)
  
  // Canales/Roles con multiplicador
  bonusChannels     Json?    // { channelId: multiplier }
  bonusRoles        Json?    // { roleId: multiplier }
  
  // Canales ignorados
  ignoredChannels   String[] @default([])
  ignoredRoles      String[] @default([])
  
  // Notificaciones
  levelUpEnabled    Boolean  @default(true)
  levelUpChannelId  String?
  levelUpMessage    String   @default("🎉 ¡{user} subió al nivel {level}!")
  
  // Roles por nivel
  levelRoles        Json?    // { level: roleId }
  stackRoles        Boolean  @default(false)

  @@map("level_configs")
}

model EconomyConfig {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  enabled         Boolean @default(true)
  currencyName    String  @default("monedas")
  currencySymbol  String  @default("🪙")
  
  // Recompensas
  dailyReward     Int     @default(100)
  weeklyReward    Int     @default(500)
  workMinReward   Int     @default(50)
  workMaxReward   Int     @default(200)
  workCooldown    Int     @default(3600)
  
  // Límites
  maxBalance      Int     @default(1000000)
  maxBank         Int     @default(5000000)
  robChance       Int     @default(40)
  robCooldown     Int     @default(7200)
  
  // Tienda
  shopEnabled     Boolean @default(true)

  @@map("economy_configs")
}

model ShopItem {
  id          String   @id @default(cuid())
  guildId     String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  
  name           String
  description    String
  translationKey String?
  price          Int
  type           String   @default("cosmetic")
  emoji          String?
  roleId         String?
  stock          Int      @default(-1)
  enabled        Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  purchases   UserInventory[]

  @@map("shop_items")
}

model UserInventory {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  itemId      String
  item        ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  
  quantity    Int      @default(1)
  equipped    Boolean  @default(false)
  usedAt      DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([guildId, userId, itemId])
  @@map("user_inventory")
}

model LoggingConfig {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false)

  // Canales de logs
  messageLogChannel    String?
  memberLogChannel     String?
  moderationLogChannel String?
  voiceLogChannel      String?
  serverLogChannel     String?
  
  // Eventos habilitados
  logMessageDelete     Boolean @default(true)
  logMessageEdit       Boolean @default(true)
  logMessageBulkDelete Boolean @default(true)
  logMemberJoin        Boolean @default(true)
  logMemberLeave       Boolean @default(true)
  logMemberUpdate      Boolean @default(true)
  logMemberBan         Boolean @default(true)
  logMemberUnban       Boolean @default(true)
  logVoiceJoin         Boolean @default(true)
  logVoiceLeave        Boolean @default(true)
  logVoiceMove         Boolean @default(true)
  logRoleCreate        Boolean @default(true)
  logRoleDelete        Boolean @default(true)
  logChannelCreate     Boolean @default(true)
  logChannelDelete     Boolean @default(true)
  
  // Filtros
  ignoredChannels      String[] @default([])
  ignoredUsers         String[] @default([])

  @@map("logging_configs")
}

model MusicConfig {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  enabled           Boolean  @default(true)
  djRoleId          String?
  djOnly            Boolean  @default(false)
  maxQueueSize      Int      @default(500)
  maxSongDuration   Int      @default(3600)
  defaultVolume     Int      @default(50)
  voteSkipEnabled   Boolean  @default(true)
  voteSkipThreshold Int      @default(50)
  autoDisconnect    Boolean  @default(true)
  disconnectDelay   Int      @default(300)
  announceNowPlaying Boolean @default(true)
  restrictedChannels String[] @default([])

  @@map("music_configs")
}

// ═══════════════════════════════════════════════════════════════
// MODERACIÓN
// ═══════════════════════════════════════════════════════════════

model ModerationCase {
  id          String   @id @default(cuid())
  caseNumber  Int
  guildId     String
  moderatorId String
  targetId    String
  action      ModerationAction
  reason      String?
  duration    Int?
  expiresAt   DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, caseNumber])
  @@index([guildId])
  @@index([targetId])
  @@map("moderation_cases")
}

enum ModerationAction {
  WARN
  TIMEOUT
  KICK
  BAN
  UNBAN
  SOFTBAN
  TEMPBAN
}

model Warning {
  id          String   @id @default(cuid())
  guildId     String
  moderatorId String
  reason      String
  createdAt   DateTime @default(now())

  guildUser   GuildUser @relation(fields: [guildUserId], references: [id], onDelete: Cascade)
  guildUserId String
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@map("warnings")
}

// ═══════════════════════════════════════════════════════════════
// FUNCIONALIDADES CORE
// ═══════════════════════════════════════════════════════════════

model CustomCommand {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  response  String
  embed     Json?
  createdBy String
  uses      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
  @@map("custom_commands")
}

model ReactionRole {
  id          String   @id @default(cuid())
  guildId     String
  channelId   String
  messageId   String
  emoji       String
  roleId      String
  type        String   @default("toggle") // toggle, add, remove, unique
  description String?
  requireRole String?
  maxUses     Int?
  currentUses Int      @default(0)
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([messageId, emoji])
  @@map("reaction_roles")
}

model Giveaway {
  id          String   @id @default(cuid())
  guildId     String
  channelId   String
  messageId   String?
  hostId      String
  prize       String
  winners     Int      @default(1)
  endsAt      DateTime
  ended       Boolean  @default(false)
  winnerIds   String[] @default([])
  requirements Json?
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@map("giveaways")
}

model Suggestion {
  id          String   @id @default(cuid())
  guildId     String
  channelId   String
  messageId   String?
  authorId    String
  content     String
  category    String   @default("general")
  status      SuggestionStatus @default(PENDING)
  upvotes     Int      @default(0)
  downvotes   Int      @default(0)
  response    String?
  responderId String?
  // { votes: { up: [], down: [], neutral: [] }, priority, displayStatus }
  meta        Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@map("suggestions")
}

enum SuggestionStatus {
  PENDING
  APPROVED
  DENIED
  IMPLEMENTED
}

// ═══════════════════════════════════════════════════════════════
// SISTEMA DE ADDONS
// ═══════════════════════════════════════════════════════════════

model AddonLicense {
  id                    String   @id @default(cuid())
  guildId               String
  addonName             String
  userId                String   // Quien compró
  plan                  String   @default("individual") // individual | bundle
  status                AddonStatus @default(ACTIVE)
  paypalSubscriptionId  String?
  paypalCustomerId      String?
  price                 Float    @default(2.99)
  currency              String   @default("USD")
  expiresAt             DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  cancelledAt           DateTime?
  suspendedAt           DateTime?
  kickoutAt             DateTime?
  paymentFailures       Int      @default(0)
  lastPaymentFailedAt   DateTime?

  // Cortesías (activadas por el equipo de Korex)
  courtesy              Boolean  @default(false)
  courtesyReason        String?
  courtesyBy            String?  // admin_users.id

  // Limpieza de datos tras expiración (30 días de gracia)
  dataWarnedAt          DateTime?  // cuándo se envió el aviso de 24h antes del borrado
  dataDeletedAt         DateTime?  // cuándo se eliminaron los datos del addon

  // Relaciones
  guild                 Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, addonName])
  @@index([guildId])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([dataDeletedAt])
  @@map("addon_licenses")
}

enum AddonStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
  TRIAL
  KICKOUT
}

model AddonConfig {
  id        String   @id @default(cuid())
  guildId   String
  addonName String
  config    Json     // Configuración específica del addon
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  
  @@unique([guildId, addonName])
  @@map("addon_configs")
}

// ═══════════════════════════════════════════════════════════════
// PREMIUM POR SERVIDOR (planes Basic/Pro)
// ═══════════════════════════════════════════════════════════════

model GuildPremium {
  id                   String    @id @default(cuid())
  guildId              String    @unique
  planId               String    // 'demo' | 'basic' | 'pro'
  userId               String    // quien activó / compró
  paypalSubscriptionId String?
  status               String    @default("ACTIVE") // ACTIVE | CANCELLED | EXPIRED | SUSPENDED
  isDemo               Boolean   @default(false)
  startedAt            DateTime  @default(now())
  expiresAt            DateTime
  cancelledAt          DateTime?
  suspendedAt          DateTime?
  kickoutAt            DateTime?
  paymentFailures      Int       @default(0)
  lastPaymentFailedAt  DateTime?

  // Contadores de uso (para controlar límites por plan)
  usageAutoResponses   Int       @default(0)
  usageGiveaways       Int       @default(0)
  usagePolls           Int       @default(0)
  usageCustomCommands  Int       @default(0)
  usageYoutubeMonthly  Int       @default(0)   // YouTube plays this billing month
  usageYoutubeResetAt  DateTime  @default(now()) // When the monthly counter resets
  usageAiMonthly       Int       @default(0)   // MusicGPT AI generations this billing month
  usageAiResetAt       DateTime  @default(now()) // When the AI monthly counter resets

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  guild                Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([status])
  @@index([expiresAt])
  @@map("guild_premiums")
}

// ═══════════════════════════════════════════════════════════════
// SERVICIOS BASE (LEGACY)
// ═══════════════════════════════════════════════════════════════

model License {
  id        String   @id
  addonId   String
  guildId   String
  type      String   // FREE, PREMIUM, ENTERPRISE
  features  String[] @default([])
  expiresAt DateTime?
  isActive  Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([addonId, guildId])
  @@index([guildId])
  @@index([addonId])
  @@map("licenses")
}

model ErrorLog {
  id        String   @id @default(cuid())
  type      String   // COMMAND_ERROR, INTERACTION_ERROR, SYSTEM_ERROR, ADDON_ERROR
  message   String
  stack     String?
  context   Json
  severity  String   // LOW, MEDIUM, HIGH, CRITICAL
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([type])
  @@index([severity])
  @@index([createdAt])
  @@map("error_logs")
}

model ModerationActionLog {
  id          String   @id @default(cuid())
  type        String   // WARN, MUTE, KICK, BAN, UNBAN, UNMUTE
  guildId     String
  userId      String
  moderatorId String
  reason      String
  duration    Int?     // en minutos
  expiresAt   DateTime?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([guildId])
  @@index([userId])
  @@index([type])
  @@index([isActive])
  @@map("moderation_action_logs")
}

model GuildConfig {
  id                String   @id @default(cuid())
  guildId           String   @unique
  language          String   @default("en")
  
  // Moderation
  autoModEnabled    Boolean  @default(false)
  logChannelId      String?
  muteRoleId        String?
  maxWarnings       Int      @default(3)
  warningExpireDays Int      @default(30)
  autoActions       Json     @default("[]")
  
  // Logging
  loggingEnabled    Boolean  @default(false)
  loggingChannels   Json     @default("{}")
  loggingEvents     Json     @default("{}")
  
  // Welcome/Goodbye
  welcomeEnabled           Boolean  @default(false)
  welcomeChannelId         String?
  welcomeMessage           String?
  welcomeEmbedEnabled      Boolean  @default(true)
  welcomeEmbedColor        String   @default("#00ff00")
  welcomeEmbedTitle        String?
  welcomeEmbedDescription  String?
  welcomeEmbedThumbnail    Boolean  @default(true)
  welcomeEmbedFooter       String?
  welcomeDmEnabled         Boolean  @default(false)
  welcomeDmMessage         String?
  welcomeRoleId            String?
  welcomeImageEnabled      Boolean  @default(false)
  welcomeImageTemplate     String   @default("default")
  welcomeButtonsEnabled    Boolean  @default(false)
  welcomeButtons           Json     @default("[]")
  
  goodbyeEnabled           Boolean  @default(false)
  goodbyeChannelId         String?
  goodbyeMessage           String?
  goodbyeEmbedEnabled      Boolean  @default(true)
  goodbyeEmbedColor        String   @default("#ff0000")
  goodbyeEmbedTitle        String?
  goodbyeEmbedDescription  String?
  
  // Auto Role
  autoRoleEnabled          Boolean  @default(false)
  autoRoleJoinRoles        Json     @default("[]")
  autoRoleLevelRoles       Json     @default("[]")
  autoRoleBoostRoles       Json     @default("[]")
  
  // Suggestions
  suggestionChannelId      String?
  // { staffRoleIds, voterRoleIds, cooldown, autoCreateThreads, notifyAuthor }
  suggestionSettings       Json     @default("{}")
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("guild_configs")
}

// ═══════════════════════════════════════════════════════════════
// ANALYTICS & LOGS
// ═══════════════════════════════════════════════════════════════

model CommandUsage {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  command     String
  success     Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([guildId])
  @@index([command])
  @@map("command_usage")
}

model GuildAnalytics {
  id           String   @id @default(cuid())
  guildId      String
  date         DateTime @db.Date
  members      Int
  messages     Int
  voiceMinutes Int
  commands     Int
  joins        Int
  leaves       Int
  dau          Int      @default(0)
  topUserShare Float    @default(0)

  @@unique([guildId, date])
  @@index([guildId])
  @@map("guild_analytics")
