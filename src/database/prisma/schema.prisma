// Korex Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Use postgresql by default
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// CORE MODELS
// ═══════════════════════════════════════════════════════════════

model Guild {
  id        String   @id // Discord Guild ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // General settings
  prefix        String   @default("!")
  prefixEnabled Boolean  @default(true) // Prefix/mention commands enabled
  language      String   @default("es")
  timezone      String   @default("UTC")
  embedColor    String   @default("#00D9FF")
  
  // Enabled modules
  enabledAddons String[] @default([])

  // Per-server bot identity
  botNickname   String?

  // Account suspension (by the Korex admin team)
  suspended     Boolean   @default(false)
  suspendedAt   DateTime?
  suspendReason String?

  // Record of the bot leaving the server
  leftAt        DateTime?
  
  // Module settings
  moderationConfig  ModerationConfig?
  moderationRaidState ModerationRaidState?
  welcomeConfig     WelcomeConfig?
  levelConfig       LevelConfig?
  economyConfig     EconomyConfig?
  loggingConfig     LoggingConfig?
  musicConfig       MusicConfig?
  
  // Relations
  users             GuildUser[]
  moderationCases   ModerationCase[]
  warnings          Warning[]
  customCommands    CustomCommand[]
  reactionRoles     ReactionRole[]
  giveaways         Giveaway[]
  suggestions       Suggestion[]
  addonLicenses     AddonLicense[]
  addonConfigs      AddonConfig[]
  shopItems         ShopItem[]
  premium           GuildPremium?
  starboardConfig      StarboardConfig?
  starboardEntries     StarboardEntry[]
  honeypotConfig       HoneypotConfig?
  honeypotLogs         HoneypotLog[]
  operators            GuildOperator[]
  operatorInvites      GuildOperatorInvite[]

  @@map("guilds")
  inviteStats     InviteStats[]
  stickyMessages  StickyMessage[]
  channelLockdowns ChannelLockdown[]
  inviteRewardConfig InviteRewardConfig?
  inviteRewardTiers  InviteRewardTier[]
  inviteRewardGrants InviteRewardGrant[]
}

model User {
  id        String   @id // Discord User ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Global user data
  globalXp       Int      @default(0)
  globalLevel    Int      @default(0)
  globalBalance  Int      @default(0)
  premiumUntil   DateTime?
  badges         String[] @default([])
  
  // Personal settings
  language       String   @default("es")
  dmNotifications Boolean @default(true)
  
  // Relations
  guilds         GuildUser[]
  
  @@map("users")
}

model GuildUser {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Levels and XP
  xp           Int      @default(0)
  level        Int      @default(0)
  totalXp      Int      @default(0)
  messages     Int      @default(0)
  voiceMinutes Int      @default(0)
  lastXpGain   DateTime?

  // Economy
  balance      Int      @default(0)
  bank         Int      @default(0)
  dailyStreak  Int      @default(0)
  lastDaily    DateTime?
  lastWeekly   DateTime?
  lastWork     DateTime?

  // Moderation
  warnings     Warning[]
  notes        String[]  @default([])
  isMuted      Boolean   @default(false)
  muteExpires  DateTime?

  // AFK
  isAfk        Boolean   @default(false)
  afkMessage   String?
  afkSince     DateTime?

  // Relations
  guild        Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId])
  @@index([userId])
  @@map("guild_users")
}

// ═══════════════════════════════════════════════════════════════
// CONFIGURATIONS
// ═══════════════════════════════════════════════════════════════

model ModerationConfig {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  // Auto-moderation
  autoModEnabled     Boolean  @default(false)
  antiSpam           Boolean  @default(false)
  antiSpamThreshold  Int      @default(5)
  antiSpamInterval   Int      @default(5)
  antiRaid           Boolean  @default(false)
  antiRaidThreshold  Int      @default(10)        // joins within the window
  // Moderation anti-raid (additive columns): window, age filter,
  // action on members joining during the raid, lockdown mode and duration
  antiRaidWindow         Int    @default(60)      // seconds (10 = "users per minute")
  antiRaidAccountAgeDays Int    @default(0)       // 0 = counts any account; >0 only newer accounts
  antiRaidAction         String @default("alert") // alert | timeout | kick | ban
  antiRaidLockdown       String @default("none")  // none | verification | channels | both
  antiRaidDuration       Int    @default(600)     // seconds until raid mode is turned off
  antiNuke           Boolean  @default(false)
  antiGhostPing      Boolean  @default(false)
  
  // Filters
  wordFilterEnabled  Boolean  @default(false)
  filteredWords      String[] @default([])
  linkFilterEnabled  Boolean  @default(false)
  allowedLinks       String[] @default([])
  capsFilterEnabled  Boolean  @default(false)
  capsThreshold      Int      @default(70)
  
  // Automatic actions
  warnThreshold      Int      @default(3)
  warnAction         String   @default("timeout") // timeout, kick, ban
  warnActionDuration Int      @default(3600)
  // Warning escalation from /setup (3 → timeout, 5 → kick, 7 → ban), disabled by default
  warnEscalationEnabled Boolean @default(false)
  warnEscalationSteps   Json    @default("[{\"warnings\":3,\"action\":\"timeout\",\"duration\":60},{\"warnings\":5,\"action\":\"kick\"},{\"warnings\":7,\"action\":\"ban\",\"duration\":1440}]")
  applyToModerators  Boolean  @default(false)
  
  // Ignored channels
  ignoredChannels    String[] @default([])
  ignoredRoles       String[] @default([])

  // Attachment anti-spam (images, files)
  antiAttachmentSpam        Boolean @default(false)
  antiAttachmentThreshold   Int     @default(3)
  antiAttachmentInterval    Int     @default(10)
  maxAttachmentsPerMessage  Int     @default(0)
  blockAllAttachments       Boolean @default(false)

  @@map("moderation_configs")
}

// Moderation raid mode state (one per server). Stores the snapshot
// of the previous state (verification level and @everyone permissions) to
// restore it exactly even if the bot restarts during the raid.
model ModerationRaidState {
  guildId            String    @id
  guild              Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  active             Boolean   @default(true)
  startedAt          DateTime  @default(now())
  endsAt             DateTime
  endedAt            DateTime?
  endedBy            String?   // user id, "auto" or "dashboard:<id>"
  joinCount          Int       @default(0)
  actionCount        Int       @default(0)
  action             String    @default("alert")
  verificationBefore Int?      // null = not changed
  verificationSet    Int?
  channelSnapshot    Json      @default("[]") // [{ id, existed, bits: { SendMessages: true|false|null, ... } }]
  updatedAt          DateTime  @updatedAt

  @@index([active, endsAt])
  @@map("moderation_raid_states")
}

model WelcomeConfig {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  // Welcome
  welcomeEnabled   Boolean @default(false)
  welcomeChannelId String?
  welcomeMessage   String  @default("¡Bienvenido {user} a {server}!")
  welcomeEmbed     Json?
  welcomeImage         Boolean @default(false)
  welcomeImageUrl      String?
  welcomeImageTemplate String  @default("modern-dark")
  welcomeDM            Boolean @default(false)
  welcomeDMMessage String?

  // Goodbye
  goodbyeEnabled   Boolean @default(false)
  goodbyeChannelId String?
  goodbyeMessage   String  @default("¡Hasta luego {user}!")
  goodbyeEmbed     Json?
  goodbyeImage     Boolean @default(false)
  goodbyeImageUrl  String?

  // Auto-role
  autoRoleEnabled  Boolean  @default(false)
  autoRoles        String[] @default([])

  // Verification
  verificationEnabled    Boolean @default(false)
  verificationRole       String?
  verificationType       String  @default("button") // button | reaction | captcha
  verificationChannel    String?
  verificationMessageId  String?
  verificationEmoji      String  @default("✅")
  verificationEmbedTitle String  @default("Server Verification")
  verificationEmbedDesc  String  @default("Click the button below to verify yourself and gain access to the server.")
  verificationEmbedColor String  @default("#5865F2")
  // Captcha (only with verificationType = "captcha")
  verificationCaptchaMaxAttempts Int    @default(3)      // failures allowed per code (1-10)
  verificationCaptchaCooldown    Int    @default(10)     // lockout minutes after running out of attempts (1-1440)
  verificationCaptchaFailAction  String @default("none") // none | kick
  // Time limit to verify after joining (0 = disabled), in minutes
  verificationTimeoutMinutes     Int    @default(0)

  @@map("welcome_configs")
}

model LevelConfig {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  enabled           Boolean  @default(true)
  xpPerMessage      Int      @default(15)
  xpPerVoiceMinute  Int      @default(5)
  xpCooldown        Int      @default(60)
  xpMultiplier      Float    @default(1.0)
  
  // Channels/roles with multiplier
  bonusChannels     Json?    // { channelId: multiplier }
  bonusRoles        Json?    // { roleId: multiplier }
  
  // Ignored channels
  ignoredChannels   String[] @default([])
  ignoredRoles      String[] @default([])
  
  // Notifications
  levelUpEnabled    Boolean  @default(true)
  levelUpChannelId  String?
  levelUpMessage    String   @default("🎉 ¡{user} subió al nivel {level}!")
  
  // Roles per level
  levelRoles        Json?    // { level: roleId }
  stackRoles        Boolean  @default(false)

  @@map("level_configs")
}

model EconomyConfig {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  enabled         Boolean @default(true)
  currencyName    String  @default("monedas")
  currencySymbol  String  @default("🪙")
  
  // Rewards
  dailyReward     Int     @default(100)
  weeklyReward    Int     @default(500)
  workMinReward   Int     @default(50)
  workMaxReward   Int     @default(200)
  workCooldown    Int     @default(3600)
  
  // Limits
  maxBalance      Int     @default(1000000)
  maxBank         Int     @default(5000000)
  robChance       Int     @default(40)
  robCooldown     Int     @default(7200)
  
  // Shop
  shopEnabled     Boolean @default(true)

  @@map("economy_configs")
}

model ShopItem {
  id          String   @id @default(cuid())
  guildId     String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  
  name           String
  description    String
  translationKey String?
  price          Int
  type           String   @default("cosmetic")
  emoji          String?
  roleId         String?
  stock          Int      @default(-1)
  enabled        Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  purchases   UserInventory[]

  @@map("shop_items")
}

model UserInventory {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  itemId      String
  item        ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  
  quantity    Int      @default(1)
  equipped    Boolean  @default(false)
  usedAt      DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([guildId, userId, itemId])
  @@map("user_inventory")
}

model LoggingConfig {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false)

  // Log channels
  messageLogChannel    String?
  memberLogChannel     String?
  moderationLogChannel String?
  voiceLogChannel      String?
  serverLogChannel     String?
  
  // Enabled events
  logMessageDelete     Boolean @default(true)
  logMessageEdit       Boolean @default(true)
  logMessageBulkDelete Boolean @default(true)
  logMemberJoin        Boolean @default(true)
  logMemberLeave       Boolean @default(true)
  logMemberUpdate      Boolean @default(true)
  logMemberBan         Boolean @default(true)
  logMemberUnban       Boolean @default(true)
  logVoiceJoin         Boolean @default(true)
  logVoiceLeave        Boolean @default(true)
  logVoiceMove         Boolean @default(true)
  logRoleCreate        Boolean @default(true)
  logRoleDelete        Boolean @default(true)
  logChannelCreate     Boolean @default(true)
  logChannelDelete     Boolean @default(true)
  
  // Filters
  ignoredChannels      String[] @default([])
  ignoredUsers         String[] @default([])

  @@map("logging_configs")
}

model MusicConfig {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  enabled           Boolean  @default(true)
  djRoleId          String?
  djOnly            Boolean  @default(false)
  maxQueueSize      Int      @default(500)
  maxSongDuration   Int      @default(3600)
  defaultVolume     Int      @default(50)
  voteSkipEnabled   Boolean  @default(true)
  voteSkipThreshold Int      @default(50)
  autoDisconnect    Boolean  @default(true)
  disconnectDelay   Int      @default(300)
  announceNowPlaying Boolean @default(true)
  restrictedChannels String[] @default([])

  @@map("music_configs")
}

// ═══════════════════════════════════════════════════════════════
// MODERATION
// ═══════════════════════════════════════════════════════════════

model ModerationCase {
  id          String   @id @default(cuid())
  caseNumber  Int
  guildId     String
  moderatorId String
  targetId    String
  action      ModerationAction
  reason      String?
  duration    Int?
  expiresAt   DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, caseNumber])
  @@index([guildId])
  @@index([targetId])
  @@map("moderation_cases")
}

enum ModerationAction {
  WARN
  TIMEOUT
  KICK
  BAN
  UNBAN
  SOFTBAN
  TEMPBAN
}

model Warning {
  id          String   @id @default(cuid())
  guildId     String
  moderatorId String
  reason      String
  createdAt   DateTime @default(now())

  guildUser   GuildUser @relation(fields: [guildUserId], references: [id], onDelete: Cascade)
  guildUserId String
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@map("warnings")
}

// ═══════════════════════════════════════════════════════════════
// CORE FEATURES
// ═══════════════════════════════════════════════════════════════

model CustomCommand {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  response  String
  embed     Json?
  createdBy String
  uses      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
  @@map("custom_commands")
}

model ReactionRole {
  id          String   @id @default(cuid())
  guildId     String
  channelId   String
  messageId   String
  emoji       String
  roleId      String
  type        String   @default("toggle") // toggle, add, remove, unique
  description String?
  requireRole String?
  maxUses     Int?
  currentUses Int      @default(0)
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([messageId, emoji])
  @@map("reaction_roles")
}

model Giveaway {
  id          String   @id @default(cuid())
  guildId     String
  channelId   String
  messageId   String?
  hostId      String
  prize       String
  winners     Int      @default(1)
  endsAt      DateTime
  ended       Boolean  @default(false)
  winnerIds   String[] @default([])
  requirements Json?
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@map("giveaways")
}

model Suggestion {
  id          String   @id @default(cuid())
  guildId     String
  channelId   String
  messageId   String?
  authorId    String
  content     String
  category    String   @default("general")
  status      SuggestionStatus @default(PENDING)
  upvotes     Int      @default(0)
  downvotes   Int      @default(0)
  response    String?
  responderId String?
  // { votes: { up: [], down: [], neutral: [] }, priority, displayStatus }
  meta        Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@map("suggestions")
}

enum SuggestionStatus {
  PENDING
  APPROVED
  DENIED
  IMPLEMENTED
}

// ═══════════════════════════════════════════════════════════════
// ADDON SYSTEM
// ═══════════════════════════════════════════════════════════════

model AddonLicense {
  id                    String   @id @default(cuid())
  guildId               String
  addonName             String
  userId                String   // Who purchased
  plan                  String   @default("individual") // individual | bundle
  status                AddonStatus @default(ACTIVE)
  paypalSubscriptionId  String?
  paypalCustomerId      String?
  price                 Float    @default(2.99)
  currency              String   @default("USD")
  expiresAt             DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  cancelledAt           DateTime?
  suspendedAt           DateTime?
  kickoutAt             DateTime?
  paymentFailures       Int      @default(0)
  lastPaymentFailedAt   DateTime?

  // Courtesy grants (activated by the Korex team)
  courtesy              Boolean  @default(false)
  courtesyReason        String?
  courtesyBy            String?  // admin_users.id

  // Data cleanup after expiration (30-day grace period)
  dataWarnedAt          DateTime?  // when the 24h pre-deletion notice was sent
  dataDeletedAt         DateTime?  // when the addon data was deleted

  // Relations
  guild                 Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, addonName])
  @@index([guildId])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([dataDeletedAt])
  @@map("addon_licenses")
}

enum AddonStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
  TRIAL
  KICKOUT
}

model AddonConfig {
  id        String   @id @default(cuid())
  guildId   String
  addonName String
  config    Json     // Addon-specific configuration
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  
  @@unique([guildId, addonName])
  @@map("addon_configs")
}

// ═══════════════════════════════════════════════════════════════
// PER-SERVER PREMIUM (Basic/Pro plans)
// ═══════════════════════════════════════════════════════════════

model GuildPremium {
  id                   String    @id @default(cuid())
  guildId              String    @unique
  planId               String    // 'demo' | 'basic' | 'pro'
  userId               String    // who activated / purchased
  paypalSubscriptionId String?
  status               String    @default("ACTIVE") // ACTIVE | CANCELLED | EXPIRED | SUSPENDED
  isDemo               Boolean   @default(false)
  startedAt            DateTime  @default(now())
  expiresAt            DateTime
  cancelledAt          DateTime?
  suspendedAt          DateTime?
  kickoutAt            DateTime?
  paymentFailures      Int       @default(0)
  lastPaymentFailedAt  DateTime?

  // Usage counters (to enforce per-plan limits)
  usageAutoResponses   Int       @default(0)
  usageGiveaways       Int       @default(0)
  usagePolls           Int       @default(0)
  usageCustomCommands  Int       @default(0)
  usageYoutubeMonthly  Int       @default(0)   // YouTube plays this billing month
  usageYoutubeResetAt  DateTime  @default(now()) // When the monthly counter resets
  usageAiMonthly       Int       @default(0)   // MusicGPT AI generations this billing month
  usageAiResetAt       DateTime  @default(now()) // When the AI monthly counter resets

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  guild                Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([status])
  @@index([expiresAt])
  @@map("guild_premiums")
}

// ═══════════════════════════════════════════════════════════════
// BASE SERVICES (LEGACY)
// ═══════════════════════════════════════════════════════════════

model License {
  id        String   @id
  addonId   String
  guildId   String
  type      String   // FREE, PREMIUM, ENTERPRISE
  features  String[] @default([])
  expiresAt DateTime?
  isActive  Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([addonId, guildId])
  @@index([guildId])
  @@index([addonId])
  @@map("licenses")
}

model ErrorLog {
  id        String   @id @default(cuid())
  type      String   // COMMAND_ERROR, INTERACTION_ERROR, SYSTEM_ERROR, ADDON_ERROR
  message   String
  stack     String?
  context   Json
  severity  String   // LOW, MEDIUM, HIGH, CRITICAL
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([type])
  @@index([severity])
  @@index([createdAt])
  @@map("error_logs")
}

model ModerationActionLog {
  id          String   @id @default(cuid())
  type        String   // WARN, MUTE, KICK, BAN, UNBAN, UNMUTE
  guildId     String
  userId      String
  moderatorId String
  reason      String
  duration    Int?     // in minutes
  expiresAt   DateTime?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([guildId])
  @@index([userId])
  @@index([type])
  @@index([isActive])
  @@map("moderation_action_logs")
}

model GuildConfig {
  id                String   @id @default(cuid())
  guildId           String   @unique
  language          String   @default("en")
  
  // Moderation
  autoModEnabled    Boolean  @default(false)
  logChannelId      String?
  muteRoleId        String?
  maxWarnings       Int      @default(3)
  warningExpireDays Int      @default(30)
  autoActions       Json     @default("[]")
  
  // Logging
  loggingEnabled    Boolean  @default(false)
  loggingChannels   Json     @default("{}")
  loggingEvents     Json     @default("{}")
  
  // Welcome/Goodbye
  welcomeEnabled           Boolean  @default(false)
  welcomeChannelId         String?
  welcomeMessage           String?
  welcomeEmbedEnabled      Boolean  @default(true)
  welcomeEmbedColor        String   @default("#00ff00")
  welcomeEmbedTitle        String?
  welcomeEmbedDescription  String?
  welcomeEmbedThumbnail    Boolean  @default(true)
  welcomeEmbedFooter       String?
  welcomeDmEnabled         Boolean  @default(false)
  welcomeDmMessage         String?
  welcomeRoleId            String?
  welcomeImageEnabled      Boolean  @default(false)
  welcomeImageTemplate     String   @default("default")
  welcomeButtonsEnabled    Boolean  @default(false)
  welcomeButtons           Json     @default("[]")
  
  goodbyeEnabled           Boolean  @default(false)
  goodbyeChannelId         String?
  goodbyeMessage           String?
  goodbyeEmbedEnabled      Boolean  @default(true)
  goodbyeEmbedColor        String   @default("#ff0000")
  goodbyeEmbedTitle        String?
  goodbyeEmbedDescription  String?
  
  // Auto Role
  autoRoleEnabled          Boolean  @default(false)
  autoRoleJoinRoles        Json     @default("[]")
  autoRoleLevelRoles       Json     @default("[]")
  autoRoleBoostRoles       Json     @default("[]")
  
  // Suggestions
  suggestionChannelId      String?
  // { staffRoleIds, voterRoleIds, cooldown, autoCreateThreads, notifyAuthor }
  suggestionSettings       Json     @default("{}")
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("guild_configs")
}

// ═══════════════════════════════════════════════════════════════
// ANALYTICS & LOGS
// ═══════════════════════════════════════════════════════════════

model CommandUsage {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  command     String
  success     Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([guildId])
  @@index([command])
  @@map("command_usage")
}

model GuildAnalytics {
  id           String   @id @default(cuid())
  guildId      String
  date         DateTime @db.Date
  members      Int
  messages     Int
  voiceMinutes Int
  commands     Int
  joins        Int
  leaves       Int
  dau          Int      @default(0)
  topUserShare Float    @default(0)

  @@unique([guildId, date])
  @@index([guildId])
  @@map("guild_analytics")
}

// ═══════════════════════════════════════════════════════════════
// NEW SERVICES
// ═══════════════════════════════════════════════════════════════

model LogEntry {
  id        String   @id @default(cuid())
  guildId   String
  type      String
  userId    String?
  channelId String?
  data      Json
  createdAt DateTime @default(now())

  @@index([guildId])
  @@index([type])
  @@map("log_entries")
}

// Pending delayed join roles to assign (AutoRoleService). They persist
// the scheduled assignment so a bot restart does not lose it.
model PendingJoinRole {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  roleId    String
  dueAt     DateTime
  createdAt DateTime @default(now())

  @@unique([guildId, userId, roleId])
  @@index([dueAt])
  @@map("pending_join_roles")
}

model ReactionRoleMessage {
  id           String   @id @default(cuid())
  guildId      String
  channelId    String
  messageId    String
  title        String
  description  String
  color        String
  type         String   @default("MULTIPLE") // SINGLE, MULTIPLE, UNIQUE
  roles        Json     @default("[]")
  imageUrl     String?
  thumbnailUrl String?
  footerText   String?
  createdAt    DateTime @default(now())

  @@unique([guildId, messageId])
  @@map("reaction_role_messages")
}

model Poll {
  id           String    @id @default(cuid())
  guildId      String
  channelId    String
  messageId    String?
  creatorId    String?
  question     String
  description  String?
  type         String    @default("simple")
  options      Json
  settings     Json      @default("{}")
  restrictions Json      @default("[]")
  participants Json      @default("[]")
  anonymous    Boolean   @default(false)
  endTime      DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  @@index([guildId])
  @@index([active])
  @@map("polls")
}

// ═══════════════════════════════════════════════════════════════
// AUTO-RESPONSE SYSTEM
// ═══════════════════════════════════════════════════════════════

model AutoResponse {
  id            String   @id @default(cuid())
  guildId       String
  name          String
  triggers      String[] // Array of trigger words/phrases
  triggerType   AutoResponseTriggerType @default(CONTAINS)
  caseSensitive Boolean  @default(false)
  cooldown      Int      @default(5) // seconds
  enabled       Boolean  @default(true)
  createdBy     String
  usageCount    Int      @default(0)
  lastUsed      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  actions       AutoResponseAction[]
  
  @@index([guildId])
  @@index([enabled])
  @@map("auto_responses")
}

enum AutoResponseTriggerType {
  EXACT
  CONTAINS
  STARTS
  ENDS
  REGEX
}

model AutoResponseAction {
  id             String   @id @default(cuid())
  autoResponseId String
  type           AutoResponseActionType
  order          Int      @default(0)
  
  // Text/Embed content
  content        String?
  embedTitle     String?
  embedDescription String?
  embedColor     String?
  embedThumbnail String?
  embedImage     String?
  embedFooter    String?
  
  // Reaction/Role
  emoji          String?
  roleId         String?
  
  // Behavior
  deleteOriginal Boolean  @default(false)
  delay          Int      @default(0) // milliseconds
  
  createdAt      DateTime @default(now())
  
  // Relations
  autoResponse   AutoResponse @relation(fields: [autoResponseId], references: [id], onDelete: Cascade)
  
  @@index([autoResponseId])
  @@map("auto_response_actions")
}

enum AutoResponseActionType {
  TEXT
  EMBED
  REACTION
  DM
  ROLE_ADD
  ROLE_REMOVE
}

