  guildId   String
  type      String
  userId    String?
  channelId String?
  data      Json
  createdAt DateTime @default(now())

  @@index([guildId])
  @@index([type])
  @@map("log_entries")
}

// Roles de entrada con retraso pendientes de asignar (AutoRoleService). Persisten
// la asignación programada para que un reinicio del bot no la pierda.
model PendingJoinRole {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  roleId    String
  dueAt     DateTime
  createdAt DateTime @default(now())

  @@unique([guildId, userId, roleId])
  @@index([dueAt])
  @@map("pending_join_roles")
}

model ReactionRoleMessage {
  id           String   @id @default(cuid())
  guildId      String
  channelId    String
  messageId    String
  title        String
  description  String
  color        String
  type         String   @default("MULTIPLE") // SINGLE, MULTIPLE, UNIQUE
  roles        Json     @default("[]")
  imageUrl     String?
  thumbnailUrl String?
  footerText   String?
  createdAt    DateTime @default(now())

  @@unique([guildId, messageId])
  @@map("reaction_role_messages")
}

model Poll {
  id           String    @id @default(cuid())
  guildId      String
  channelId    String
  messageId    String?
  creatorId    String?
  question     String
  description  String?
  type         String    @default("simple")
  options      Json
  settings     Json      @default("{}")
  restrictions Json      @default("[]")
  participants Json      @default("[]")
  anonymous    Boolean   @default(false)
  endTime      DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  @@index([guildId])
  @@index([active])
  @@map("polls")
}

// ═══════════════════════════════════════════════════════════════
// AUTO-RESPONSE SYSTEM
// ═══════════════════════════════════════════════════════════════

model AutoResponse {
  id            String   @id @default(cuid())
  guildId       String
  name          String
  triggers      String[] // Array of trigger words/phrases
  triggerType   AutoResponseTriggerType @default(CONTAINS)
  caseSensitive Boolean  @default(false)
  cooldown      Int      @default(5) // seconds
  enabled       Boolean  @default(true)
  createdBy     String
  usageCount    Int      @default(0)
  lastUsed      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relaciones
  actions       AutoResponseAction[]
  
  @@index([guildId])
  @@index([enabled])
  @@map("auto_responses")
}

enum AutoResponseTriggerType {
  EXACT
  CONTAINS
  STARTS
  ENDS
  REGEX
}

model AutoResponseAction {
  id             String   @id @default(cuid())
  autoResponseId String
  type           AutoResponseActionType
  order          Int      @default(0)
  
  // Text/Embed content
  content        String?
  embedTitle     String?
  embedDescription String?
  embedColor     String?
  embedThumbnail String?
  embedImage     String?
  embedFooter    String?
  
  // Reaction/Role
  emoji          String?
  roleId         String?
  
  // Behavior
  deleteOriginal Boolean  @default(false)
  delay          Int      @default(0) // milliseconds
  
  createdAt      DateTime @default(now())
  
  // Relaciones
  autoResponse   AutoResponse @relation(fields: [autoResponseId], references: [id], onDelete: Cascade)
  
  @@index([autoResponseId])
  @@map("auto_response_actions")
}

enum AutoResponseActionType {
  TEXT
  EMBED
  REACTION
  DM
  ROLE_ADD
  ROLE_REMOVE
}

// ═══════════════════════════════════════════════════════════════
// ADMIN PANEL — OPERADORES
// ═══════════════════════════════════════════════════════════════

model AdminUser {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  name           String
  role           String    @default("support") // super_admin | support | billing | developer | marketing
  totpSecret     String?
  totpEnabled    Boolean   @default(false)
  webauthnCreds  Json      @default("[]")   // array de credenciales WebAuthn (id, publicKey, counter, deviceType, backedUp, transports)
  backupCodes    String[]  @default([])     // códigos hashed con Argon2id
  allowedIps     String[]  @default([])     // vacío = sin restricción
  active         Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions       AdminSession[]
  auditLogs      AdminAuditLog[]
  assignedTickets SupportTicket[] @relation("AssignedTickets")
  replyTemplates  SupportReplyTemplate[]
  createdCoupons  Coupon[]
  clientNotes     ClientNote[]

  @@map("admin_users")
}

model AdminSession {
  id           String    @id @default(uuid())
  adminUserId  String
  sessionToken String    @unique  // SHA-256 del session ID real (nunca guardar el ID en claro)
  ip           String?
  userAgent    String?
  expiresAt    DateTime
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())

  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model AdminAuditLog {
  id             String    @id @default(uuid())
  operatorId     String?                       // admin_users.id o 'system' (null si se elimina el operador)
  operatorEmail  String?                       // snapshot en el momento
  action         String                        // 'license.courtesy' | 'client.suspend' | etc.
  targetType     String?                       // 'guild' | 'license' | 'coupon' | 'operator'
  targetId       String?
  payload        Json      @default("{}")      // datos antes/después del cambio
  ip             String?
  createdAt      DateTime  @default(now())

  operator       AdminUser? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([operatorId])
  @@index([targetType, targetId])
  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_log")
}

// ═══════════════════════════════════════════════════════════════
// ADMIN PANEL — CATÁLOGO DE ADDONS
// ═══════════════════════════════════════════════════════════════

model AddonCatalog {
  addonName    String    @id
  displayName  String
  description  String?   @db.Text
  price        Decimal   @default(2.99) @db.Decimal(10, 2)
  currency     String    @default("USD")
  paypalPlanId String?
  status       String    @default("available") // available | beta | soon | hidden
  features     String[]  @default([])
  changelog    Json      @default("[]")        // [{ version, date, notes }]
  updatedAt    DateTime  @updatedAt

  @@map("addon_catalog")
}

// ═══════════════════════════════════════════════════════════════
// ADMIN PANEL — HISTORIAL DE PAGOS
// ═══════════════════════════════════════════════════════════════

model PaymentTransaction {
  id           String    @id @default(uuid())
  guildId      String
  addonName    String?
  planId       String?
  amount       Decimal   @db.Decimal(10, 2)
  currency     String    @default("USD")
  type         String                        // initial | renewal | refund
  status       String                        // completed | failed | refunded | pending
  paypalTxId   String?
  paypalSubId  String?
  refundReason String?
  refundRef    String?
  createdAt    DateTime  @default(now())

  @@index([guildId])
  @@index([createdAt(sort: Desc)])
  @@index([paypalSubId])
  @@map("payment_transactions")
}

// ═══════════════════════════════════════════════════════════════
// ADMIN PANEL — CUPONES
// ═══════════════════════════════════════════════════════════════

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String                       // percent | fixed
  discountValue Decimal   @db.Decimal(10, 2)
  addonName     String?                      // null = aplica a todos
  maxUses       Int?                         // null = ilimitado
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  active        Boolean   @default(true)
  createdBy     String
  createdAt     DateTime  @default(now())

  creator       AdminUser  @relation(fields: [createdBy], references: [id])
  uses          CouponUse[]

  @@map("coupons")
}

model CouponUse {
  id        String    @id @default(uuid())
  couponId  String
  guildId   String
  usedAt    DateTime  @default(now())
  discount  Decimal   @db.Decimal(10, 2)

  coupon    Coupon    @relation(fields: [couponId], references: [id])

  @@unique([couponId, guildId])
  @@map("coupon_uses")
}

// ═══════════════════════════════════════════════════════════════
// ADMIN PANEL — TICKETS DE SOPORTE INTERNO (guild owner → Korex)
// ═══════════════════════════════════════════════════════════════

model SupportTicket {
  id                  String    @id @default(uuid())
  guildId             String
  userId              String                      // Discord user ID del solicitante
  subject             String
  category            String    @default("other") // technical | configuration | billing | feature | bug | other
  description         String    @db.Text
  status              String    @default("open")  // open | in_progress | closed | waiting_customer
  priority            String    @default("normal") // low | normal | high | urgent
  assignedTo          String?                     // admin_users.id
  addonName           String?
  unreadGuild         Int       @default(0)        // mensajes nuevos del equipo sin leer
  unreadAdmin         Int       @default(0)        // mensajes nuevos del guild sin leer
  firstResponseAt     DateTime?
  closedAt            DateTime?
  firstResponseTime   Int?                        // segundos hasta primera respuesta
  resolutionTime      Int?                        // segundos hasta cierre
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  assignedOperator    AdminUser?              @relation("AssignedTickets", fields: [assignedTo], references: [id], onDelete: SetNull)
  messages            SupportTicketMessage[]
  attachments         SupportTicketAttachment[]

  @@index([guildId])
  @@index([status])
  @@index([assignedTo])
  @@index([createdAt(sort: Desc)])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id         String    @id @default(uuid())
  ticketId   String
  senderId   String                          // admin_users.id O Discord user ID
  isStaff    Boolean   @default(false)
  content    String    @db.Text
  sentVia    String[]  @default([])          // ['dm', 'email']
  createdAt  DateTime  @default(now())

  ticket       SupportTicket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments  SupportTicketAttachment[]

  @@index([ticketId])
  @@map("support_ticket_messages")
}

model SupportTicketAttachment {
  id          String    @id @default(uuid())
  ticketId    String
  messageId   String?
  filename    String
  mimetype    String
  sizeBytes   Int
  storageType String    @default("disk")     // disk | r2
  storageKey  String                         // ruta en disco o key en R2
  createdAt   DateTime  @default(now())

  ticket      SupportTicket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message     SupportTicketMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@map("support_ticket_attachments")
}

model SupportReplyTemplate {
  id        String    @id @default(uuid())
  name      String
  content   String    @db.Text
  createdBy String
  createdAt DateTime  @default(now())

  creator   AdminUser @relation(fields: [createdBy], references: [id])

  @@map("support_reply_templates")
}

// ═══════════════════════════════════════════════════════════════
// ADMIN PANEL — CONTACTOS Y NOTAS DE CLIENTES
// ═══════════════════════════════════════════════════════════════

model GuildContact {
  guildId   String    @id
  email     String?
  discordId String                            // owner Discord ID
  updatedAt DateTime  @updatedAt

  @@map("guild_contacts")
}

model ClientNote {
  guildId   String    @id
  content   String    @default("") @db.Text
  updatedBy String?                           // admin_users.id
  updatedAt DateTime  @updatedAt

  updater   AdminUser? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("client_notes")
}

// ═══════════════════════════════════════════════════════════════
// ADMIN PANEL — MARKETING
// ═══════════════════════════════════════════════════════════════

model MarketingSegment {
  id         String    @id @default(uuid())
  name       String
  conditions Json                             // [{field, operator, value}]
  createdBy  String
  createdAt  DateTime  @default(now())

  campaigns  MarketingCampaign[]

  @@map("marketing_segments")
}

model MarketingCampaign {
  id          String    @id @default(uuid())
  name        String
  segmentId   String?
  channel     String                         // email | discord_dm | both
  subject     String?
  content     String    @db.Text
  status      String    @default("draft")    // draft | scheduled | sending | sent | failed
  scheduledAt DateTime?
  sentAt      DateTime?
  sentCount   Int       @default(0)
  failedCount Int       @default(0)
  createdBy   String
  createdAt   DateTime  @default(now())

  segment     MarketingSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  @@map("marketing_campaigns")
}

// ═══════════════════════════════════════════════════════════════
// ADMIN PANEL — LOG DE EMAILS
// ═══════════════════════════════════════════════════════════════

model EmailLog {
  id         String    @id @default(uuid())
  guildId    String?
  recipient  String
  templateId String
  campaignId String?
  status     String    @default("sent")      // sent | failed | opened
  resendId   String?
  error      String?
  sentAt     DateTime  @default(now())

  @@index([guildId])
  @@map("email_log")
}

// ═══════════════════════════════════════════════════════════════
// ADMIN PANEL — PREFERENCIAS DE NOTIFICACIÓN DEL GUILD
// ═══════════════════════════════════════════════════════════════

model GuildNotificationPref {
  guildId      String    @id
  supportEmail Boolean   @default(true)
  supportDm    Boolean   @default(false)
  supportBadge Boolean   @default(true)
  updatedAt    DateTime  @updatedAt

  @@map("guild_notification_prefs")
}

// ─────────────────────────────────────────────
//  STARBOARD
// ─────────────────────────────────────────────

model StarboardConfig {
  id              String   @id @default(cuid())
  guildId         String   @unique
  channelId       String
  emoji           String   @default("⭐")
  threshold       Int      @default(3)
  selfStar        Boolean  @default(false)
  ignoreBots      Boolean  @default(true)
  ignoreNsfw      Boolean  @default(true)
  enabled         Boolean  @default(true)
  ignoredChannels String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  entries         StarboardEntry[]

  @@map("starboard_configs")
}

model HoneypotConfig {
  id              String   @id @default(cuid())
  guildId         String   @unique
  enabled         Boolean  @default(true)

  // Canal trampa
  channelEnabled  Boolean  @default(false)
  channelId       String?
  channelAction   String   @default("kick")   // kick | ban | timeout | log

  // Anti-raid (sliding window)
  raidEnabled     Boolean  @default(true)
  raidThreshold   Int      @default(10)        // joins en el período
  raidWindow      Int      @default(10)        // segundos
  raidAction      String   @default("log")    // lockdown | kick | ban | log

  // Filtro de cuentas nuevas
  newAccountEnabled Boolean @default(false)
  newAccountDays    Int     @default(7)        // días mínimos de antigüedad
  newAccountAction  String  @default("kick")

  // Canal de logs
  logChannelId    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("honeypot_configs")
}

model HoneypotLog {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  type      String   // channel_message | mass_join | new_account
  action    String   // kicked | banned | timed_out | logged
  details   String?
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([guildId, createdAt])
  @@map("honeypot_logs")
}

model StarboardEntry {
  id             String        @id @default(cuid())
  guildId        String
  configId       String?
  originalMsgId  String        @unique
  originalChId   String
  starboardMsgId String
  authorId       String
  starCount      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  guild          Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  config         StarboardConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)

  @@index([guildId])
  @@index([authorId])
  @@map("starboard_entries")
}

// ═══════════════════════════════════════════════════════════════
// TEAM ACCESS — RBAC por Guild
// ═══════════════════════════════════════════════════════════════

model GuildOperator {
  id          String    @id @default(cuid())
  guildId     String
  userId      String    // Discord User ID del colaborador
  invitedBy   String    // Discord User ID de quien invitó
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expiresAt   DateTime?             // null = sin expiración
  revokedAt   DateTime?             // null = activo
  revokedBy   String?               // quien revocó

  // Permisos por sección — ver OperatorPermissions en types/teamAccess.ts
  permissions Json

  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId])
  @@index([userId])
  @@index([guildId, userId, revokedAt])
  @@map("guild_operators")
}

model GuildOperatorLog {
  id          String   @id @default(cuid())
  guildId     String
  operatorId  String   // Discord userId de quien realizó la acción
  username    String   // snapshot del username en el momento
  action      String   // "config_saved" | "invite_generated" | "operator_added" | "operator_revoked" | etc.
  section     String   // "moderation" | "economy" | "team" | etc.
  details     Json     // datos adicionales (antes/después, parámetros, etc.)
  ipHash      String?  // hash SHA-256 de la IP (GDPR: no guardar IP en claro)
  createdAt   DateTime @default(now())

  @@index([guildId])
  @@index([guildId, createdAt])
  @@index([operatorId])
  @@map("guild_operator_logs")
}

// Canales bloqueados con /lockdown: overwrite original de @everyone para restaurarlo
// exactamente al desbloquear (también tras un reinicio del bot)
model ChannelLockdown {
  channelId     String   @id
  guildId       String
  type          String   // channel | server
  everyoneAllow String?  // bitfield original (null = no había overwrite)
  everyoneDeny  String?
  moderatorId   String
  reason        String
  createdAt     DateTime @default(now())

  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@map("channel_lockdowns")
}

// Mensajes fijados que se re-publican al final del canal (/sticky)
model StickyMessage {
  channelId String   @id
  guildId   String
  content   String
  useEmbed  Boolean  @default(false)
  color     Int?
  messageId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@map("sticky_messages")
}

// Estadísticas de invitaciones por usuario (/invites)
model InviteStats {
  id           String   @id @default(cuid())
  guildId      String
  userId       String
  totalInvites Int      @default(0)
  validInvites Int      @default(0)
  fakeInvites  Int      @default(0)
  leftInvites  Int      @default(0)
  bonusInvites Int      @default(0)
  invitedUsers String[] @default([])
  fakeInvitedUsers String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  guild        Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId])
  @@map("invite_stats")
}

// Recompensas por invitaciones: ajustes por servidor (/invites config)
model InviteRewardConfig {
  guildId           String   @id
  enabled           Boolean  @default(true)
  stackRoles        Boolean  @default(true)  // true: conserva los roles anteriores; false: solo el más alto
  removeOnDrop      Boolean  @default(true)  // retira el rol si las invitaciones válidas bajan del umbral
  announceChannelId String?                  // aviso opcional al alcanzar una recompensa
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  guild             Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("invite_reward_configs")
}

// Recompensas por invitaciones: umbral (invitaciones válidas) → rol
model InviteRewardTier {
  id              String   @id @default(cuid())
  guildId         String
  requiredInvites Int
  roleId          String
  createdAt       DateTime @default(now())

  guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, requiredInvites])
  @@unique([guildId, roleId])
  @@index([guildId])
  @@map("invite_reward_tiers")
}

// Roles de recompensa entregados por el bot (solo estos se retiran después)
model InviteRewardGrant {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  roleId    String
  grantedAt DateTime @default(now())

  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId, roleId])
  @@index([guildId, userId])
  @@map("invite_reward_grants")
}

model GuildOperatorInvite {
  id          String    @id @default(cuid())
  guildId     String
  token       String    @unique @default(cuid())
  invitedBy   String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  usedBy      String?   // Discord User ID del que aceptó
  targetUserId String?  // Si está definido, solo este Discord ID puede aceptar el invite
  permissions Json      // permisos pre-asignados al invite

  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([guildId])
  @@map("guild_operator_invites")
}
