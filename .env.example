# ═══════════════════════════════════════════════════════════════
# KOREX - Environment Configuration
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# DISCORD
# ─────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_DEV_GUILD_ID=              # Development guild (instant commands)

# ─────────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────────
DATABASE_PROVIDER=postgresql       # postgresql | mongodb | mysql | sqlite
DATABASE_URL=postgresql://user:password@localhost:5432/korex

# ─────────────────────────────────────────────────────────────────
# REDIS (Cache and Sessions)
# ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_PREFIX=korex:

# ─────────────────────────────────────────────────────────────────
# LAVALINK (Music)
# ─────────────────────────────────────────────────────────────────
MUSIC_ENABLED=true
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
LAVALINK_IDENTIFIER=main-node
LAVALINK_RESUME_KEY=
LAVALINK_RESUME_TIMEOUT=60000
LAVALINK_AUTO_RESUME=true
LAVALINK_USE_VERSION_PATH=true

# Music APIs
YOUTUBE_API_ENABLED=true
YOUTUBE_API_KEY=
SPOTIFY_API_ENABLED=true
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SOUNDCLOUD_API_ENABLED=true
SOUNDCLOUD_CLIENT_ID=

# Music Configuration
MUSIC_DEFAULT_VOLUME=50
MUSIC_MAX_QUEUE_SIZE=500
MUSIC_MAX_SONG_DURATION=3600
MUSIC_SEARCH_LIMIT=10
MUSIC_LEAVE_ON_EMPTY=true
MUSIC_LEAVE_ON_EMPTY_DELAY=300000
MUSIC_LEAVE_ON_END=true
MUSIC_LEAVE_ON_END_DELAY=30000

# ─────────────────────────────────────────────────────────────────
# API / PANEL WEB
# ─────────────────────────────────────────────────────────────────
API_PORT=3000
API_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:5173
JWT_SECRET=                        # Generate with: openssl rand -hex 64
JWT_EXPIRES_IN=7d
SESSION_SECRET=                    # Generate with: openssl rand -hex 32
CORS_ORIGINS=http://localhost:5173,https://panel.korex.dev

# Webhooks
GITHUB_WEBHOOK_SECRET=
WEBHOOK_TOKEN=                     # For custom webhooks
STRIPE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────
# LICENSING
# ─────────────────────────────────────────────────────────────────
LICENSE_KEY=
LICENSE_SERVER_URL=https://license.korex.dev/api
INSTALLATION_TOKEN=                # Auto-generated on first start

# ─────────────────────────────────────────────────────────────────
# ADDONS (Individual license keys)
# ─────────────────────────────────────────────────────────────────
ADDON_STORE_LICENSE=
ADDON_STAFF_LICENSE=
ADDON_TICKETS_LICENSE=
ADDON_FORMS_LICENSE=
ADDON_LINKS_LICENSE=
ADDON_PASTE_LICENSE=
ADDON_MUSIC_PRO_LICENSE=
ADDON_ANALYTICS_PRO_LICENSE=
ADDON_IA_ASSISTANT_LICENSE=

# PayPal — Plan IDs per addon (create in PayPal Dashboard > Products & Plans)
PAYPAL_PLAN_TICKETS=
PAYPAL_PLAN_STAFF=
PAYPAL_PLAN_FORMS=
PAYPAL_PLAN_STORE=
PAYPAL_PLAN_LINKS=
PAYPAL_PLAN_PASTE=
PAYPAL_PLAN_MUSIC_PRO=
PAYPAL_PLAN_ANALYTICS_PRO=
PAYPAL_PLAN_AI_ASSISTANT=

# ─────────────────────────────────────────────────────────────────
# EXTERNAL INTEGRATIONS
# ─────────────────────────────────────────────────────────────────
# Payments (Addon Store)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI (Addon IA Assistant)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Other
LASTFM_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────
# GENERAL CONFIGURATION
# ─────────────────────────────────────────────────────────────────
NODE_ENV=development               # development | production | test
LOG_LEVEL=info                     # debug | info | warn | error
DEFAULT_PREFIX=!
DEFAULT_LANGUAGE=es
TIMEZONE=America/Mexico_City

# ─────────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=                    # Generate with: openssl rand -hex 32
ERROR_CHANNEL_ID=                  # Channel to report critical errors
# ─────────────────────────────────────────────────────────────────
# PANEL WEB (korex-web)
# ─────────────────────────────────────────────────────────────────
PANEL_URL=https://panel.korex.dev  # User dashboard URL

